# ── Paddle (contract v1 — see paddle-billing plugin) ─────────────────────
# One .env per environment. The sync script reads PADDLE_ENV from THIS file
# and only writes IDs from that environment into it.
PADDLE_ENV=sandbox                 # sandbox | production
# Paddle > Developer Tools > Authentication > API keys
#   sandbox: pdl_sdbx_apikey_...   production: pdl_live_apikey_...
PADDLE_API_KEY=
# Paddle > Developer Tools > Authentication > Client-side tokens (public)
#   sandbox: test_...              production: live_...
PADDLE_CLIENT_TOKEN=
# If set, the sync script creates/updates the webhook destination and fills
# PADDLE_WEBHOOK_SECRET + PADDLE_NOTIFICATION_SETTING_ID automatically.
PADDLE_WEBHOOK_URL=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SEC=5
APP_BASE_URL=http://localhost:3000
# One-time goods only: >=32 random bytes, e.g. `openssl rand -hex 32`
DOWNLOAD_SIGNING_SECRET=
# ── Everything below is written by paddle-sync — do not edit by hand ─────
